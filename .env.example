# Copy to .env locally; never commit credentials. Same app key authenticates KR/US.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# mock or live (mock keys and live keys are separate)
KIWOOM_ENV=mock
# Separate opt-in, in addition to typing confirmation in the dashboard.
ALLOW_LIVE_TRADING=false
# US tick timestamp timezone: set ONLY after checking broker trade timestamps.
# KIWOOM_US_TIMESTAMP_TZ=Asia/Seoul
# Retained local state. Never share the resulting account/order database.
TRADER_DATA_DIR=data
